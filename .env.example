# LLM（翻訳・レビュー）を使う場合のみ必要。未設定でも決定論的検査は動く
ANTHROPIC_API_KEY=

# 使用モデル
IR_REVIEW_MODEL=claude-sonnet-4-5

# 事故防止の上限。公開デモではここが最後の砦になる
IR_REVIEW_MAX_PAGES=5
IR_REVIEW_MAX_SEGMENTS=60
IR_REVIEW_MAX_TRANSLATE_RETRIES=1

# Web公開時のアクセスキー。空なら認証なし（ローカル実行を想定）
IR_REVIEW_ACCESS_KEY=
IR_REVIEW_RATE_LIMIT_PER_HOUR=10
